{
  "name": "pcms-userscript",
  "private": true,
  "version": "0.1.2",
  "description": "PCMS Perchance management userscript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:bootstrap": "node scripts/check-bootstrap.mjs",
    "test": "node --test tests/bootstrap.test.mjs tests/unit/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:ui": "node tests/ui/shell.mjs",
    "check:candidate": "node scripts/check-candidate.mjs",
    "build:operator-test": "node scripts/build.mjs --profile=operator-test",
    "check:operator-test": "node scripts/check-candidate.mjs --profile=operator-test"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
